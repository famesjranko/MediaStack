# LAN / bare-metal real-host test — secrets and inputs
# Copy this file to tests/.env.lan-host (gitignored) and fill in your values.
# tests/lan-host/run-fresh.sh (and the helper scripts) source it for you.
#
# This harness targets a disposable Debian test box you own. It does not run
# remote-access/provider setup; that proof belongs to tests/gcp-vm/.

# --- Target host (always required) --------------------------------------
TARGET_HOST="test-host.example.invalid"          # test box hostname/IP (NOT your prod stack)
TARGET_USER="mediastack-test"                    # SSH user with passwordless login + sudo
TARGET_PATH="/home/mediastack-test/MediaStack"   # where the repo is rsynced on the target

# Destructive-wipe guard. clean-wipe.sh / run-fresh.sh refuse a non-interactive
# (--yes) wipe unless TARGET_HOST equals this value. Set it to the SAME string as
# TARGET_HOST to opt in; a mistyped TARGET_HOST then cannot be wiped unattended.
LANHOST_EXPECT="test-host.example.invalid"

# --- Choice matrix (which install path to exercise) ---------------------
# Pick a PERSONA (expands to a toggle preset) OR set individual toggles below;
# explicit toggles override the persona. All empty/default => DEMO Mode A baseline
# (no wizard: GPU=none, indexers off, stable channel, 1080p Balanced quality, LAN-only).
#
#   lan-minimal      LAN baseline, 720p Compact quality, no GPU
#   nvidia-existing  Stage 3 -> use the already-installed NVIDIA driver   (S3.N3)
#   nvidia-standard  Stage 3 -> Debian/apt NVIDIA driver (needs reboot)   (S3.N1)
#   nvidia-unlock    Stage 3 -> Unlock-NVENC patched driver (needs reboot)
#   remote-nas       refused locally with a pointer to the GCP harness
LANHOST_PERSONA=""

# Individual toggles — leave BLANK to inherit the persona (or the DEMO baseline when no
# persona is set). Set one ONLY to override. All blank + no persona = DEMO Mode A.
LANHOST_GPU=""          # none|intel|amd|nvidia-existing|nvidia-standard|nvidia-unlock (default none)
LANHOST_INDEXERS=""     # 0|1  — public-tracker (Jackett) indexer preset (default 0)
LANHOST_CHANNEL=""      # stable|latest  — image update channel (default stable)
LANHOST_QUALITY=""      # <720p|1080p>-<compact|balanced|large>  e.g. 1080p-balanced (default 1080p-balanced)
LANHOST_BAZARR=""       # 0|1  — subtitle downloads (Bazarr) (default 0)
LANHOST_SMB=""          # 0|1  — host SMB file share (data scope: \\<ip>\Media -> /data) (default 0)
LANHOST_REMOTE=""       # 0|1  — Stage 2 remote access (collides on a home LAN; see README) (default 0)
