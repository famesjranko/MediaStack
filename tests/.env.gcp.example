# GCP MediaStack Remote Test — secrets and inputs
# Copy this file to tests/.env.gcp (gitignored) and fill in your values.
# Source it before running tests/gcp-vm/run-fresh.sh.

# --- GCP project + instance ----------------------------------------------
PROJECT_ID="your-gcp-project-id"
REGION="us-central1"
ZONE="us-central1-a"
INSTANCE="mediastack-test"
MACHINE_TYPE="e2-medium"     # 2 vCPU / 4GB RAM is enough for fresh-install
BOOT_DISK_SIZE="30GB"
REPO_URL="https://github.com/famesjranko/MediaStack.git"

# Your home/admin IP for SSH + admin tag firewall rule (see README).
# Use /32 for a single IP. Leave empty if you don't restrict admin SSH.
ADMIN_IP_CIDR="203.0.113.10/32"

# --- Pre-seed for DEMO=1 setup ------------------------------------------
# These flow into /opt/MediaStack/.env on the VM before setup.sh --full.
# Everything else (admin password, WG hash, API keys, etc.) is wizard-generated.
DOMAIN="mediastack.example.org"
NPM_ADMIN_EMAIL="you@example.com"

# Leave blank for prod Let's Encrypt (real, trusted certs — rate-limited!).
# Use staging for repeat test loops; certs will be untrusted but unrate-limited.
NPM_LE_SERVER="https://acme-staging-v02.api.letsencrypt.org/directory"

# --- DDNS (Dynu) --------------------------------------------------------
# Pre-seeded into config/ddns-updater/config.json on the VM. Replace with
# your provider's credentials. The harness only writes the dynu provider
# block; use a different provider by editing the run-fresh.sh seed step.
DDNS_USERNAME="your-dynu-username"
DDNS_PASSWORD="your-dynu-password"
