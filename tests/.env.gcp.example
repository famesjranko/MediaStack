# GCP MediaStack Remote Test — secrets and inputs
# Copy this file to tests/.env.gcp (gitignored) and fill in your values.
# The harness loads it automatically. `--preflight` uses this example when no
# local tests/.env.gcp exists and never contacts GCP.

# --- GCP project + instance ----------------------------------------------
PROJECT_ID="your-gcp-project-id"
ZONE="us-central1-a"
INSTANCE="mediastack-test"
MACHINE_TYPE="e2-medium"     # 2 vCPU / 4GB RAM is enough for fresh-install
BOOT_DISK_SIZE="30GB"

# Exact destructive-target approval. The harness deletes and recreates this VM,
# and refuses to start unless this matches PROJECT_ID/ZONE/INSTANCE exactly.
GCP_EXPECT_TARGET="your-gcp-project-id/us-central1-a/mediastack-test"

# --- Stage 2 remote-access inputs ---------------------------------------
# These flow into /opt/MediaStack/.env before the real Stage 2 wizard.
DOMAIN="mediastack.example.org"
NPM_ADMIN_EMAIL="you@example.com"

# Leave blank for prod Let's Encrypt (real, trusted certs — rate-limited!).
# Use staging for repeat test loops; certs will be untrusted but unrate-limited.
NPM_LE_SERVER="https://acme-staging-v02.api.letsencrypt.org/directory"

# --- DDNS (Dynu) --------------------------------------------------------
# The Stage 2 wizard consumes this password and renders the provider config.
DDNS_PASSWORD="your-dynu-password"
