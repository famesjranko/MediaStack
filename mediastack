#!/usr/bin/env bash
# =============================================================================
# MediaStack — front-door launcher
# =============================================================================
# Owns: launcher_* — the front-door menu and its dispatch.
# Interactive menu for non-technical users. Adapts to install state:
#   - Pre-install: install + readiness diagnostics (system, ports, DNS, public IP)
#   - Post-install: status, ports, update, configure, add-feature, manage,
#                   wipe-and-reinstall
#
# Reuses the existing pure-bash UI library (scripts/lib/ui.sh) and dispatches
# to existing scripts (setup.sh, configure.sh, port-check.sh, update.sh,
# nvidia-repatch.sh) — no business logic here.
#
# Usage: ./mediastack
# =============================================================================
set -uo pipefail # NOT -e: a failed diagnostic must not kill the loop.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

# --- Dry-run UI explorer (containerised; see scripts/lib/dry-run.sh) ---
# Checked before the root/TTY guards below (which apply to the real launcher).
# On a real host (no sandbox marker) --dry-run spawns a throwaway container and
# re-invokes inside it; inside the sandbox the marker is present, so we fall
# through to the in-container dispatch at the bottom (a no-op walk).
if [[ "${1:-}" == "--dry-run" || "${1:-}" == "--ui-preview" ]]; then
    # shellcheck source=scripts/lib/dry-run.sh
    source "$SCRIPT_DIR/scripts/lib/dry-run.sh"
    if ! dry_run_in_sandbox; then
        dry_run_launch mediastack
        exit $?
    fi
fi

# Front-door root check. setup.sh refuses root via check_not_root, but only
# after dispatch — better to fail fast here so a `sudo ./mediastack` doesn't
# render the whole menu before refusing.
if [[ $EUID -eq 0 ]]; then
    echo "Please run ./mediastack as your normal user (sudo will be used internally when needed)." >&2
    exit 1
fi

# Refuse to run with a closed/non-TTY stdin unless explicitly opted in.
# ui_choose defaults to item 1 on empty input — that's "Install MediaStack"
# pre-install or "Stop all services" in the manage submenu. A wrapper or CI
# job that closes stdin would silently trigger destructive actions.
# Set MEDIASTACK_NONINTERACTIVE=1 to drive the launcher from a piped script
# (mirrors setup.sh's MEDIASTACK_NONINTERACTIVE behavior).
if [[ ! -t 0 && "${MEDIASTACK_NONINTERACTIVE:-0}" != "1" ]]; then
    echo "./mediastack is interactive - set MEDIASTACK_NONINTERACTIVE=1 to pipe input." >&2
    exit 2
fi

source "$SCRIPT_DIR/scripts/lib/common.sh"
source "$SCRIPT_DIR/scripts/lib/ui.sh"
source "$SCRIPT_DIR/scripts/lib/network.sh"
# Input validators (e.g. validate_mb_per_sec for the day-2 bandwidth action);
# pure function defs, shared with the wizard stages.
source "$SCRIPT_DIR/scripts/lib/validators.sh"
# Shared profiles_build_args — the single source of truth for the compose
# --profile set, also used by the installer (scripts/setup/stack.sh).
source "$SCRIPT_DIR/scripts/lib/profiles.sh"
source "$SCRIPT_DIR/scripts/setup/storage.sh"
source "$SCRIPT_DIR/scripts/setup/fail2ban.sh"

# Source .env if it exists, so STAGE_1_COMPLETE / DOMAIN / JELLYFIN_GPU /
# NVIDIA_DRIVER_MODE / etc. are available. Don't fail if missing — pre-install
# is a valid state.
if [[ -f "$SCRIPT_DIR/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/.env"
    set +a
else
    # No .env = not installed. Clear state vars that a prior launcher exported
    # (set -a) and that this process inherited through exec — e.g. right after
    # --uninstall re-execs the launcher. The .env file is the source of truth;
    # a stale exported STAGE_1_COMPLETE must not keep launcher_is_installed / the menus
    # showing an installed state after the file has been removed.
    unset STAGE_1_COMPLETE DOMAIN JELLYFIN_GPU NVIDIA_DRIVER_MODE REMOTE_WEB_STATE
fi

# Recovery predicates (recovery_menu_remote_available / _transcoding_available).
# The file's other functions only execute when called, so this is safe.
source "$SCRIPT_DIR/scripts/setup/recovery.sh"

# Cache the public IP for the session — multiple banner renders should not
# re-hit the IP-detection API on every menu refresh. Primed in parent scope by
# render_banner; "Refresh status" invalidates it. (The DDNS record is NOT cached:
# it is re-resolved fresh every render so propagation self-heals — see
# _resolve_ddns_ip.)
_MS_PUBLIC_IP=""
_MS_PUBLIC_IP_CHECKED=0
_DDNS_LIVE_MUTATED=0
_GPU_WARN_DONE=
source "$SCRIPT_DIR/scripts/launcher/access-info.sh" || exit 1
source "$SCRIPT_DIR/scripts/launcher/action-result.sh" || exit 1
source "$SCRIPT_DIR/scripts/launcher/bandwidth.sh" || exit 1
source "$SCRIPT_DIR/scripts/launcher/ddns.sh" || exit 1
source "$SCRIPT_DIR/scripts/launcher/features.sh" || exit 1
source "$SCRIPT_DIR/scripts/launcher/diagnostics.sh" || exit 1
source "$SCRIPT_DIR/scripts/launcher/fail2ban.sh" || exit 1
source "$SCRIPT_DIR/scripts/launcher/hardware.sh" || exit 1
source "$SCRIPT_DIR/scripts/launcher/quality.sh" || exit 1
source "$SCRIPT_DIR/scripts/launcher/storage.sh" || exit 1
source "$SCRIPT_DIR/scripts/launcher/uninstall.sh" || exit 1
source "$SCRIPT_DIR/scripts/launcher/manage-updates.sh" || exit 1

# =============================================================================
# State detection
# =============================================================================

launcher_is_installed() {
    [[ "${STAGE_1_COMPLETE:-}" == "1" ]]
}

# =============================================================================
# Banner
# =============================================================================

launcher_action_install() {
    ui_confirm "Run the full installer now (~5-10 min, uses sudo)?" no || return 0
    _run_setup_return 1 "Install"
}
launcher_action_install_gum() {
    echo ""
    ui_log info "Installing GUM for enhanced arrow-key menus..."
    sudo -v
    local ok=true
    sudo mkdir -p /etc/apt/keyrings || ok=false
    $ok && sudo apt-get install -y -qq gnupg || ok=false
    $ok && curl -fsSL https://repo.charm.sh/apt/gpg.key \
        | sudo gpg --yes --dearmor -o /etc/apt/keyrings/charm.gpg || ok=false
    $ok && echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" \
        | sudo tee /etc/apt/sources.list.d/charm.list >/dev/null || ok=false
    $ok && ui_spin "Updating package lists..." sudo apt-get update -qq || ok=false
    $ok && ui_spin "Installing GUM..." sudo apt-get install -y -qq gum || ok=false
    if $ok; then
        ui_log ok "GUM installed — restarting with enhanced menus..."
        sleep 1
        exec "$0"
    else
        ui_log error "GUM installation failed. Check internet connectivity and try again."
        launcher_pause_for_menu
    fi
}
launcher_menu_pre() {
    echo ""
    local choice options=()
    options+=(
        "Install MediaStack"
        "System readiness check (disk, RAM, internet, GPU)"
        "Test port forwarding (router config)"
        "Check domain DNS (verify subdomain A-records)"
    )
    command -v gum &>/dev/null || options+=("Get enhanced menus (install GUM)")
    # Offer reset options when a partial install exists (.env present but Stage 1
    # not complete) — the user landed here because of a broken/interrupted setup.
    local _has_partial=false
    [[ -s "$SCRIPT_DIR/.env" ]] && _has_partial=true
    if $_has_partial; then
        options+=("Uninstall MediaStack")
    fi
    options+=("Quit")
    choice=$(ui_choose "What would you like to do?" "${options[@]}")

    case "$choice" in
        "Install MediaStack"*) launcher_action_install ;;
        "System readiness check"*)
            diag_readiness
            launcher_pause_for_menu
            ;;
        "Test port forwarding"*) action_port_check ;;
        "Check domain DNS"*)
            diag_dns_check
            launcher_pause_for_menu
            ;;
        "Get enhanced menus"*) launcher_action_install_gum ;;
        "Uninstall MediaStack"*) action_uninstall ;;
        "Quit"*)
            echo
            echo "  Goodbye."
            exit 0
            ;;
        *) ;; # unrecognized choice - re-render menu
    esac
}

launcher_menu_post() {
    # Options are grouped by how often a day-2 user reaches for them, most
    # frequent first (reorder only — no visible band headers; a header as a
    # ui_choose item would consume a selection index and shift the position-based
    # PTY drivers). "View access info" MUST stay at index 1 (PTY + unit asserts).
    # Port-forwarding tests live under Diagnostics (defaults + manual port).
    # "Manage fail2ban" sits right after "Health & security" (security-adjacent);
    # its insert renumbers every item below it +1, so dry-run.sh (Quit) and
    # wizard-ui-uninstall.sh (Uninstall) track those indices. Dispatch is
    # glob-on-string, so the case branch itself is position-independent.
    local options=(
        # Band 1 — at-a-glance / check-in
        "View access info (URLs, logins, remote, ports)"
    )
    # NAS-gated: local installs have no mount/watchdog to inspect (data dir + free
    # space already show in the Manage stack box). Gating also keeps the local-mode
    # PTY scenarios' numeric selections stable.
    if storage_is_nas; then
        options+=("View storage & data mount (NAS source, mount health, watchdog)")
    fi
    options+=(
        # Band 2 — routine management
        "Manage stack (status, stop, start, logs)"
        "Manage updates (status, per-service updates)"
        "Features & settings (quality, bandwidth, subtitles, sharing, indexers)"
        "Health & security (checks & protection)"
        "Manage fail2ban (banned IPs, whitelist, stats)"
        "Manage hardware transcoding (GPU)"
        # Band 3 — occasional / setup / destructive
        # "Re-run configuration to add new services"  # hidden: noisy on re-run, use Features & settings instead
        "Diagnostics (ports, public IP, DNS, readiness)"
        "Refresh status (re-check public IP & DDNS)"
    )
    # Offer the GUM installer only when it's missing (mirrors launcher_menu_pre:2161).
    # MUST stay before "Uninstall"/"Quit": inserting it after Uninstall would
    # shift the numeric selection PTY tests target the wrong item (see
    # tests/scenarios/wizard-ui-uninstall.sh, tests/unit/dry-run.sh). The
    # "Manage fail2ban" item above lands ahead of GUM, so those same numeric
    # drivers already absorb its +1 shift.
    command -v gum &>/dev/null || options+=("Get enhanced menus (install GUM)")
    options+=(
        "Uninstall MediaStack"
        "Quit"
    )

    _warn_gpu_runtime_fallback
    echo ""
    local choice
    choice=$(ui_choose "What would you like to do?" "${options[@]}")

    case "$choice" in
        "View access info"*)
            action_access_info
            launcher_pause_for_menu
            ;;
        "View storage"*) submenu_storage ;;
        "Manage updates"*) submenu_manage_updates ;;
        "Health & security"*) submenu_health ;;
        "Manage fail2ban"*) submenu_fail2ban ;;
        "Manage hardware transcoding"*) submenu_manage_hardware ;;
        # "Re-run configuration"*)  action_configure ;;
        "Diagnostics"*) submenu_diagnostics ;;
        # Invalidate the session public-IP cache so the next banner render re-detects it
        # (e.g. after a WAN-IP change). The DDNS record is re-resolved every render anyway,
        # so a fresh public IP is all Refresh needs to re-classify DDNS ok/stale. No pause:
        # fall through and the while-loop redraws immediately.
        "Refresh status"*) _MS_PUBLIC_IP_CHECKED=0 ;;
        "Features"*) submenu_features ;;
        "Manage stack"*) submenu_manage_stack ;;
        "Get enhanced menus"*) launcher_action_install_gum ;;
        "Uninstall"*) action_uninstall ;;
        "Quit"*)
            echo
            echo "  Goodbye."
            exit 0
            ;;
        *) ;; # unrecognized choice - re-render menu
    esac
}

# =============================================================================
# Main loop
# =============================================================================

launcher_pause_for_menu() {
    echo ""
    # `|| :` so EOF on piped stdin doesn't kill the launcher (2026-05-04 lesson).
    read -rp "  Press Enter to return to menu..." _ || :
}

main() {
    # Ctrl-C at the top level exits cleanly.
    trap 'echo; echo "  Goodbye."; exit 0' INT

    # Non-interactive (piped) driver only: ui_choose SIGTERMs the process group
    # when its stdin runs dry (it loops menus forever, so a subshell exit alone
    # can't stop it). Map that group-kill to a distinct, documented exit code so
    # a wrapper can tell "input exhausted" apart from a generic kill (143) or a
    # real failure. Interactive runs never hit ui_choose EOF, so this trap is
    # installed only when MEDIASTACK_NONINTERACTIVE=1 and leaves the TTY default
    # SIGTERM disposition untouched.
    if [[ "${MEDIASTACK_NONINTERACTIVE:-0}" == "1" ]]; then
        trap 'echo "  No more input on stdin - exiting non-interactive session." >&2; exit '"${UI_EXIT_INPUT_EXHAUSTED:-3}"'' TERM
    fi

    while true; do
        clear 2>/dev/null || printf '\033[2J\033[H'
        render_banner
        if launcher_is_installed; then
            launcher_menu_post
        else
            launcher_menu_pre
        fi
    done
}

# Only run when executed directly (sourcing for tests just exposes helpers).
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    if [[ "${1:-}" == "--dry-run" || "${1:-}" == "--ui-preview" ]]; then
        # In-container dry-run (the host path exited near the top): stub side
        # effects, seed simulated state, then walk the REAL launcher menus.
        # shellcheck source=scripts/lib/dry-run.sh
        source "$SCRIPT_DIR/scripts/lib/dry-run.sh"
        dry_run_begin launcher
        main
        exit 0
    fi
    main "$@"
fi
