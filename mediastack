    sudo -v 2>/dev/null || ui_log warn "No sudo — those checks will be skipped."
}

# Run one health check under a spinner (the fail2ban regex probes block ~15s) and
# present the verdict. Mirrors _mu_scan: the wrapped fn writes to a temp file so the
# spinner doesn't swallow its output; we present after it returns.
_health_present_spin() {
    local label="$1"; shift
    local _hc_vf; _hc_vf=$(mktemp)
    _hc_spin_run() { "$@" >"$_hc_vf" 2>/dev/null; }
    ui_spin "$label" _hc_spin_run "$@"
    unset -f _hc_spin_run
    health_present "$(cat "$_hc_vf")"
    rm -f "$_hc_vf"
}

# Run-all with a per-check spinner, reusing the library's ordered check set
# (_health_each) so the menu's set can't drift from the library's.
_health_run_all_spin() {
    _LOG_COUNTS_OK=0 _LOG_COUNTS_WARN=0 _LOG_COUNTS_ERROR=0 _LOG_COUNTS_SKIP=0
    local label fn arg
    while IFS=$'\t' read -r label fn arg; do
        _health_present_spin "Checking ${label}..." "$fn" ${arg:+"$arg"}
    done < <(_health_each)
    echo ""
    ui_log info "Summary: $(log_capture_summary)"
}

