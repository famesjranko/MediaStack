# --- Manage updates (per-service image policy + channel; ADR-30) ------------

# Echo the `--profile X` flag a service needs for compose to target it (or "").
_service_profile_flag() {
    case "$1" in
        bazarr)                     echo "--profile subtitles" ;;
        npm|fail2ban|ddns-updater)  echo "--profile proxy" ;;
        wireguard)                  echo "--profile remote" ;;
        autoheal)                   echo "--profile autoheal" ;;
        *)                          echo "" ;;
    esac
}

# Source the override generator (defines functions only) and regenerate
# docker-compose.override.yml from the live channel + per-service policy + lock.
# Mirrors scripts/update.sh so GPU/mem/NAS settings are reproduced exactly.
_regenerate_override() {
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/scripts/setup/override.sh"
    detect_host_memory >/dev/null 2>&1 || true
    generate_override "${JELLYFIN_GPU:-none}"
}

_image_policy_state_file() { printf '%s\n' "$SCRIPT_DIR/config/state/image-policy.tsv"; }

_image_policy_header() {
    echo "# MediaStack per-service image policy - managed by 'Manage updates' (ADR-30)."
    echo "# Format: service<TAB>stable|latest. Absent row = follow global IMAGE_CHANNEL."
}

# Set (or replace) a service's policy row.
_set_service_policy() {
    local svc="$1" pol="$2" file tmp
    file="$(_image_policy_state_file)"
    mkdir -p "$(dirname "$file")"
    tmp=$(mktemp)
    {
        _image_policy_header
        [[ -f "$file" ]] && awk -F '\t' -v s="$svc" \
            '$1 !~ /^#/ && NF >= 2 && $1 != s { print $1 "\t" $2 }' "$file"
        printf '%s\t%s\n' "$svc" "$pol"
    } > "$tmp"
    mv "$tmp" "$file"
}

# Remove a service's policy row (falls back to the global channel).
_clear_service_policy() {
    local svc="$1" file tmp
    file="$(_image_policy_state_file)"
    [[ -f "$file" ]] || return 0
    tmp=$(mktemp)
    {
        _image_policy_header
        awk -F '\t' -v s="$svc" \
            '$1 !~ /^#/ && NF >= 2 && $1 != s { print $1 "\t" $2 }' "$file"
    } > "$tmp"
    mv "$tmp" "$file"
}

# Rewrite a KEY=value line in .env (append if absent), single-quoted and via an
# atomic replace, by reusing the one hardened .env writer in common.sh — the same
# code path save_api_key uses. An unquoted value with a space or shell metachar
# would otherwise be mis-parsed on the launcher's next `set -a; source .env`.
_set_env_var() {
    local key="$1" val="$2" file="$SCRIPT_DIR/.env" status
    [[ -f "$file" ]] || return 1
    if ! status=$(_env_write_kv "$file" "$key" "$val"); then
        _env_write_kv_warn "$key" "$status"
        return 1
    fi
}

# Re-read .env into the environment after a day-2 mutation so the banner and
# feature-state labels reflect the change without re-exec'ing the launcher (a
# re-exec would re-run the real launcher and hit the root-EUID guard under the
# sourced test harness). Profile args are already read disk-fresh elsewhere.
_reload_env() {
    [[ -f "$SCRIPT_DIR/.env" ]] || return 0
    set -a
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/.env"
    set +a
}

# Lightweight readiness poll after a single-service recreate (no http.sh needed).
_wait_service_running() {
    local svc="$1" i=0 max=60 state health
    echo -ne "  Waiting for ${svc}..."
    while (( i < max )); do
        state=$(docker inspect --format '{{.State.Status}}' "$svc" 2>/dev/null || echo "")
        if [[ "$state" == "running" ]]; then
            health=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$svc" 2>/dev/null || echo "")
            if [[ -z "$health" || "$health" == "healthy" ]]; then
                echo -e " ${GREEN}ready${NC}"; return 0
            elif [[ "$health" == "unhealthy" ]]; then
                echo -e " ${RED}unhealthy${NC}"; return 1
            fi
        fi
        sleep 2; (( i += 2 )); echo -ne "."
    done
    echo -e " ${YELLOW}still starting${NC}"
    return 0
}

# True only when the container exists AND is currently running.
_service_is_running() {
    [[ "$(docker inspect --format '{{.State.Running}}' "$1" 2>/dev/null || echo false)" == "true" ]]
}

# Pull the (regenerated-override) image and recreate the service — but ONLY if it
# is currently running. A stopped/exited service is left stopped: the new image is
# staged and applies next time the stack starts. Never starts a stopped service.
_recreate_service() {
    local svc="$1" done_msg="$2"
    # Profile flag(s) as a proper array — matches the `${profiles[@]}` pattern
    # used everywhere else (and _build_profile_args) and removes the
    # word-splitting hazard of an unquoted $pflag. read -ra on an empty string
    # yields an empty array, so a profile-less service passes no extra args.
    local pflag=()
    read -ra pflag <<< "$(_service_profile_flag "$svc")"
    docker compose "${pflag[@]}" pull "$svc" 2>&1 || ui_log warn "Pull reported an issue; using cached image."
    if ! _service_is_running "$svc"; then
        ui_log info "${svc} is stopped - the new image is staged and applies next time it starts."
        return 0
    fi
    if docker compose "${pflag[@]}" up -d "$svc" 2>&1; then
        _wait_service_running "$svc"
        ui_log ok "$done_msg"
    else
        ui_log error "Failed to recreate ${svc}."
        return 1
    fi
}

# Apply a service update. Status-aware: a "Tested Stable update available" stays
# on Stable (re-pins to the advanced lock); an upstream update on a Stable
# install floats the service to its compose tag (sticky, outside the baseline).
_apply_service_update() {
    local svc="$1" status="${2:-}" skip_confirm="${3:-}"
    local g="${IMAGE_CHANNEL:-stable}"; g="${g,,}"
    # Float to the upstream tag only for an upstream (ahead-of-tested) update on a
    # Stable install. A tested-Stable update applies in-channel (no policy change).
    local sl="${status,,}" is_float=0
    [[ "$g" == "stable" && "$sl" == *upstream* ]] && is_float=1
    if [[ "$svc" == "wireguard" ]]; then
        ui_log warn "Updating WireGuard restarts remote access and may disconnect VPN clients."
        ui_log info "Run this from your LAN / local console if you rely on WireGuard for access."
        (( is_float )) && ui_log warn "It also moves WireGuard to its Upstream tag, outside the tested Stable baseline."
        ui_confirm "Update WireGuard now?" no || { ui_log info "Skipped WireGuard."; return 0; }
        # That single confirm already covers the float consent for WireGuard, so
        # don't re-prompt in the float branch below.
        skip_confirm=1
    fi
    if (( is_float )); then
        # Floating drops this service off the tested Stable baseline, so confirm
        # first - unless the caller already gathered consent (the "Update all"
        # path, and the WireGuard branch above, pass skip_confirm to avoid a
        # double-prompt).
        if [[ "$skip_confirm" != "1" ]]; then
            ui_log warn "This moves ${svc} to its Upstream tag, outside the tested Stable baseline."
            ui_confirm "Float ${svc} to Upstream and update?" no || { ui_log info "Left ${svc} on tested Stable."; return 0; }
        fi
        _set_service_policy "$svc" latest
        ui_log info "${svc}: now tracking its Upstream tag - outside the tested Stable baseline."
    elif [[ "$g" == "stable" ]]; then
        ui_log info "${svc}: applying the tested Stable update."
    fi
    _regenerate_override || { ui_log error "Could not regenerate compose override."; return 1; }
    storage_guard_before_start || return 1
    ui_log info "Pulling ${svc}..."
    _recreate_service "$svc" "${svc} updated."
}

# Clear a service's manual override so it follows the default channel again, and
# recreate it onto the resulting image. Under global Stable this re-pins to the
# tested lock; under global Upstream tags it follows the tag.
_reset_service_to_default() {
    local svc="$1" g="${IMAGE_CHANNEL:-stable}"; g="${g,,}"
    _clear_service_policy "$svc"
    if [[ "$g" == "stable" ]]; then
        ui_log info "${svc}: returning to the tested Stable digest..."
    else
        ui_log info "${svc}: following the default channel (Upstream tags)..."
    fi
    _regenerate_override || { ui_log error "Could not regenerate compose override."; return 1; }
    storage_guard_before_start || return 1
    _recreate_service "$svc" "${svc} reset to the default channel."
}

# Channel-agnostic scan: TSV of service<TAB>policy<TAB>override<TAB>status<TAB>updatable.
_update_status_scan() {
    python3 "$SCRIPT_DIR/scripts/image-drift.py" --status-tsv 2>/dev/null
}

_render_update_table() {
    local tsv="$1" svc pol override status upd label color has_manual=0
    printf '  %-13s %-18s %s\n' "SERVICE" "POLICY" "STATUS"
    printf '  %-13s %-18s %s\n' "-------------" "------------------" "------"
    while IFS=$'\t' read -r svc pol override status upd; do
        [[ -z "$svc" ]] && continue
        case "$pol" in
            stable) label="Stable (tested)" ;;
            latest) label="Upstream tag" ;;
            *)      label="$pol" ;;
        esac
        if [[ "$override" == "manual" ]]; then label="${label} *"; has_manual=1; fi
        case "$status" in
            "Up to date"|"On tested Stable")     color="$GREEN" ;;
            *"update available"*)                color="$YELLOW" ;;
            "Not installed"|"Unknown (offline)"|"Unknown local digest") color="$CYAN" ;;
            *)                                   color="$NC" ;;
        esac
        printf '  %-13s %-18s %b%s%b\n' "$svc" "$label" "$color" "$status" "$NC"
    done <<<"$tsv"
    (( has_manual )) && printf '  %s\n' "* manual override - not following the default channel"
}

_menu_update_selected() {
    local tsv="$1" svc pol override status upd
    local -a labels=()
    while IFS=$'\t' read -r svc pol override status upd; do
        [[ "$upd" == "true" ]] || continue
        labels+=("${svc}  (${status})")
    done <<<"$tsv"
    if (( ${#labels[@]} == 0 )); then
        ui_log info "No services have an available update."
        pause_for_menu
        return 0
    fi
    labels+=("Back")
    local choice
    choice=$(ui_choose "Update which service?" "${labels[@]}")
    [[ "$choice" == "Back" ]] && return 0
    local picked="${choice%% *}" st
    st=$(awk -F '\t' -v s="$picked" '$1 == s { print $4 }' <<<"$tsv")
    _apply_service_update "$picked" "$st"
    pause_for_menu
}

_menu_update_all() {
    local tsv="$1" svc pol override status upd wg_updatable=0 tested_pending=0
    local -a svcs=()
    # Only services with an *upstream* (ahead-of-tested) update. Tested-Stable
    # updates belong to "Pull tested Stable updates"; WireGuard is excluded here.
    local sl
    while IFS=$'\t' read -r svc pol override status upd; do
        [[ "$upd" == "true" ]] || continue
        sl="${status,,}"
        if [[ "$sl" != *upstream* ]]; then tested_pending=1; continue; fi
        if [[ "$svc" == "wireguard" ]]; then wg_updatable=1; continue; fi
        svcs+=("$svc")
    done <<<"$tsv"
    if (( ${#svcs[@]} == 0 )); then
        if (( tested_pending )); then
            ui_log info "Only tested Stable updates are pending - use 'Pull tested Stable updates'."
        elif (( wg_updatable )); then
            ui_log info "Only WireGuard has an update - use 'Update a service' to update it explicitly."
        else
            ui_log info "No upstream updates available."
        fi
        pause_for_menu
        return 0
    fi
    ui_log warn "About to update ${#svcs[@]} service(s) to their Upstream tag."
    ui_log info "May use images not yet accepted in the tested Stable record."
    ui_log info "Services: ${svcs[*]}"
    (( wg_updatable )) && ui_log info "WireGuard is excluded (remote access) - update it explicitly if needed."
    ui_confirm "Proceed?" no || { ui_log info "Cancelled."; pause_for_menu; return 0; }
    local s st
    for s in "${svcs[@]}"; do
        st=$(awk -F '\t' -v k="$s" '$1 == k { print $4 }' <<<"$tsv")
        # skip_confirm=1: the bulk "Proceed?" above already covered these floats,
        # so don't re-prompt per service inside _apply_service_update.
        _apply_service_update "$s" "$st" 1
    done
    pause_for_menu
}

_menu_reset_default() {
    local tsv="$1" svc pol override status upd
    local -a labels=()
    # Only services with an *explicit* override (not those merely inheriting the
    # global channel) and that have a container. A stopped one is staged, not
    # started (see _recreate_service); Not installed (no container) is skipped.
    while IFS=$'\t' read -r svc pol override status upd; do
        [[ "$override" == "manual" ]] || continue
        [[ "$status" == "Not installed" ]] && continue
        labels+=("${svc}  (${status})")
    done <<<"$tsv"
    if (( ${#labels[@]} == 0 )); then
        ui_log info "No services have a manual override to reset."
        pause_for_menu
        return 0
    fi
    labels+=("Back")
    local choice
    choice=$(ui_choose "Reset which service to the default channel?" "${labels[@]}")
    [[ "$choice" == "Back" ]] && return 0
    _reset_service_to_default "${choice%% *}"
    pause_for_menu
}

_menu_switch_channel() {
    local cur="${IMAGE_CHANNEL:-stable}"; cur="${cur,,}"
    local target cur_label tgt_label
    if [[ "$cur" == "stable" ]]; then target="latest"; else target="stable"; fi
    [[ "$cur" == "stable" ]] && cur_label="Stable (tested)" || cur_label="Upstream tags"
    [[ "$target" == "stable" ]] && tgt_label="Stable (tested)" || tgt_label="Upstream tags"
    ui_log info "Default image channel is currently: ${cur_label}"
    ui_log info "This affects only services without a per-service override."
    ui_confirm "Switch default channel to ${tgt_label}?" no || { ui_log info "Unchanged."; pause_for_menu; return 0; }
    _set_env_var IMAGE_CHANNEL "$target"
    export IMAGE_CHANNEL="$target"
    if _regenerate_override; then
        ui_log ok "Default channel set to ${tgt_label}."
        ui_log info "Use 'Pull tested Stable updates' or 'Update all' to apply images."
    else
        ui_log error "Override regenerate failed."
    fi
    pause_for_menu
}

submenu_manage_updates() {
    clear
    render_banner
    echo ""
    if ! _docker_reachable; then
        ui_log warn "Docker isn't reachable - cannot check for image updates."
        pause_for_menu
        return 0
    fi
    ui_log info "Checking each image against its registry (a few seconds)..."
    local tsv
    tsv=$(_update_status_scan)
    if [[ -z "$tsv" ]]; then
        ui_log error "Could not read update status (is python3 + python3-yaml installed?)."
        pause_for_menu
        return 0
    fi
    echo ""
    _render_update_table "$tsv"
    echo ""
    local choice
    choice=$(ui_choose "Manage updates:" \
        "Update a service" \
        "Update all upstream-tag services" \
        "Pull tested Stable updates (recommended)" \
        "Reset a service to the default channel" \
        "Switch default channel (Stable / Upstream tags)" \
        "Back")

    case "$choice" in
        "Update a service"*)          _menu_update_selected "$tsv" ;;
        "Update all upstream-tag"*)   _menu_update_all "$tsv" ;;
        "Pull tested Stable"*)        action_update ;;
        "Reset a service to the default channel"*) _menu_reset_default "$tsv" ;;
        "Switch default channel"*)    _menu_switch_channel ;;
        *)                            return 0 ;;
    esac
}

