# =============================================================================
# Manage fail2ban — day-2 banned-IP hub, whitelist + jail stats/history (the
# write actions live in the launcher, health.sh stays a pure verdict library).
# The banned-IP list is the hub: pick an address, then Unban or Unban+always-allow
# (both share f2b_ip_actions, reachable from the hub AND from a jail's drill-down).
# Reuses the health.sh docker-exec parse shape; every `docker exec` is best-effort
# (2>/dev/null / || guarded) so a mid-session container drop degrades to a warn or
# a zero count, never a crash. Whitelist is the ONLY config-mutating area — it edits
# the live jail.d ignoreip line, so its write helper carries four load-bearing
# robustness rules (below).
# =============================================================================

# Echo one "<jail>\t<ip>" line per currently-banned IP across all jails. Callers:
# the banner summary, the Banned-IPs hub, the context-action screen and the
# whitelist quick-pick all build their views/pick lists from these pairs.
_f2b_banned_pairs() {
    local status jails j
    status=$(docker exec fail2ban fail2ban-client status 2>/dev/null | tr -d '\r') || return 0
    jails=$(sed -n 's/.*Jail list:[[:space:]]*//p' <<<"$status" | tr ',' ' ')
    for j in $jails; do
        local jstat iplist ip
        jstat=$(docker exec fail2ban fail2ban-client status "$j" 2>/dev/null | tr -d '\r') || continue
        iplist=$(sed -n 's/.*Banned IP list:[[:space:]]*//p' <<<"$jstat" | head -1)
        for ip in $iplist; do printf '%s\t%s\n' "$j" "$ip"; done
    done
}

# Main-banner "Banned now" value: "N IPs  (jellyfin 2, npm 1)", "1 IP  (...)" or
# "none". ONE pass over _f2b_banned_pairs (1 + J execs = the banner's whole budget,
# same shape as Manage Stack's per-loop `docker ps`). The tally lists only jails
# with a live ban, in jail-list order; a mid-session container drop collapses the
# whole thing to "none" rather than crashing the redraw.
_f2b_banned_now_summary() {
    local pairs ip ips=() tally n plural
    pairs=$(_f2b_banned_pairs)
    while IFS= read -r ip; do [[ -n "$ip" ]] && ips+=("$ip"); done < <(cut -f2 <<<"$pairs" | sort -u)
    n=${#ips[@]}
    (( n == 0 )) && { printf 'none'; return 0; }
    tally=$(awk -F'\t' '
        NF==2 { if (!($1 in seen)) { seen[$1]=1; order[++c]=$1 } t[$1]++ }
        END   { sep=""; for (i=1;i<=c;i++) { printf "%s%s %d", sep, order[i], t[order[i]]; sep=", " } }' <<<"$pairs")
    plural=s; (( n == 1 )) && plural=""
    printf '%d IP%s  (%s)' "$n" "$plural" "$tally"
}

# Count the ignoreip tokens in the live jail file, split into locked-defaults vs
# user-added, for the "N defaults + M custom" banner/whitelist rows. One read feeds
# both counts; an unreadable file yields "? ?" so a count never lies with 0. Split
# glob-safe (read -ra, no pathname expansion) so a hand-added '10.*' token counts
# verbatim, not expanded against CWD - mirrors f2b_whitelist_apply.
_f2b_wl_counts() {                          # echoes "<defaults> <custom>"
    local jail_file="$SCRIPT_DIR/config/fail2ban/jail.d/mediastack.conf"
    local content line tok toks=() d=0 c=0
    content=$(cat "$jail_file" 2>/dev/null); [[ -z "$content" ]] && content=$(sudo -n cat "$jail_file" 2>/dev/null)
    [[ -z "$content" ]] && { printf '? ?\n'; return 0; }
    line=$(grep -m1 '^ignoreip[[:space:]]*=' <<<"$content")
    read -ra toks <<<"${line#*=}"
    for tok in "${toks[@]+"${toks[@]}"}"; do
        if _f2b_wl_is_default "$tok"; then d=$(( d + 1 )); else c=$(( c + 1 )); fi
    done
    printf '%d %d\n' "$d" "$c"
}

