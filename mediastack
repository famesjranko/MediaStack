menu_pre() {
    echo ""
    local choice
    choice=$(ui_choose "What would you like to do?" \
        "Install MediaStack" \
        "System readiness check (disk, RAM, internet, GPU)" \
        "Test port forwarding (router config)" \
        "Check domain DNS (verify subdomain A-records)" \
        "Show my public IP" \
        "Quit")

    case "$choice" in
        "Install MediaStack"*)         action_install ;;
        "System readiness check"*)     diag_readiness; pause_for_menu ;;
        "Test port forwarding"*)       action_port_check ;;
        "Check domain DNS"*)           diag_dns_check; pause_for_menu ;;
        "Show my public IP"*)          diag_public_ip; pause_for_menu ;;
        "Quit"*)                       echo; echo "  Goodbye."; exit 0 ;;
        *)                             ;;  # unrecognized choice - re-render menu
    esac
}

menu_post() {
    # The port-check parenthetical only honestly applies once a real domain
    # is configured — pre-Stage-2 the script can only probe TCP 6881.
    local pc_label="Test port forwarding (router config)"
    if [[ -n "${DOMAIN:-}" && "${DOMAIN:-}" != "example.com" ]]; then
        pc_label="Test port forwarding (DNS, ports, HTTP)"
    fi
    # Options are grouped by how often a day-2 user reaches for them, most
    # frequent first (reorder only — no visible band headers; a header as a
    # ui_choose item would consume a selection index and shift the position-based
    # PTY drivers). "View access info" MUST stay at index 1 (PTY + unit asserts).
    local options=(
        # Band 1 — at-a-glance / check-in
        "View access info (URLs, logins, remote, ports)"
        "Show service status"
        "$pc_label"
        # Band 2 — routine management
        "Manage stack (stop, start, logs)"
        "Manage updates (status, per-service, channel)"
        "Features & settings (quality, bandwidth, subtitles, sharing, indexers)"
        "Manage hardware transcoding (GPU)"
        # Band 3 — occasional / setup / destructive
        "Re-run configuration to add new services"
        "Diagnostics (public IP, DNS, readiness)"
        "Wipe and reinstall (destructive)"
        "Quit"
    )

    echo ""
    local choice
    choice=$(ui_choose "What would you like to do?" "${options[@]}")

    case "$choice" in
        "View access info"*)      action_access_info; pause_for_menu ;;
        "Show service status"*)   diag_status; pause_for_menu ;;
        "Test port forwarding"*)  action_port_check ;;
        "Manage updates"*)        submenu_manage_updates ;;
        "Manage hardware transcoding"*) submenu_manage_hardware ;;
        "Re-run configuration"*)  action_configure ;;
        "Diagnostics"*)           submenu_diagnostics ;;
        "Features"*)              submenu_features ;;
        "Manage stack"*)          submenu_manage_stack ;;
        "Wipe and reinstall"*)    action_wipe ;;
        "Quit"*)                  echo; echo "  Goodbye."; exit 0 ;;
        *)                        ;;  # unrecognized choice - re-render menu
    esac
}

# =============================================================================
# Main loop
# =============================================================================

pause_for_menu() {
    echo ""
    # `|| :` so EOF on piped stdin doesn't kill the launcher (2026-05-04 lesson).
    read -rp "  Press Enter to return to menu..." _ || :
}

main() {
    # Ctrl-C at the top level exits cleanly.
    trap 'echo; echo "  Goodbye."; exit 0' INT

    # Non-interactive (piped) driver only: ui_choose SIGTERMs the process group
    # when its stdin runs dry (it loops menus forever, so a subshell exit alone
    # can't stop it). Map that group-kill to a distinct, documented exit code so
    # a wrapper can tell "input exhausted" apart from a generic kill (143) or a
    # real failure. Interactive runs never hit ui_choose EOF, so this trap is
    # installed only when MEDIASTACK_NONINTERACTIVE=1 and leaves the TTY default
    # SIGTERM disposition untouched.
    if [[ "${MEDIASTACK_NONINTERACTIVE:-0}" == "1" ]]; then
        trap 'echo "  No more input on stdin - exiting non-interactive session." >&2; exit '"${UI_EXIT_INPUT_EXHAUSTED:-3}"'' TERM
    fi

    while true; do
        clear 2>/dev/null || printf '\033[2J\033[H'
        render_banner
        if is_installed; then
            menu_post
        else
            menu_pre
        fi
    done
}

# Only run when executed directly (sourcing for tests just exposes helpers).
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    if [[ "${1:-}" == "--dry-run" || "${1:-}" == "--ui-preview" ]]; then
        # In-container dry-run (the host path exited near the top): stub side
        # effects, seed simulated state, then walk the REAL launcher menus.
        # shellcheck source=scripts/lib/dry_run.sh
        source "$SCRIPT_DIR/scripts/lib/dry_run.sh"
        dry_run_begin launcher
        main
        exit 0
    fi
    main "$@"
fi
