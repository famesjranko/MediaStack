# Secrets
.env
.env.gcp
.env.lan-host
tests/gcp-mediastack-plan.md

# NVIDIA patch repo + driver download scratch (cloned/used by setup.sh)
.nvidia-patch/
.nvidia-tmp/

# Generated by setup.sh (resource limits + GPU config)
docker-compose.override.yml

# Root runtime markers (written by setup.sh, removed on uninstall)
/.setup-result
/.nvidia-finalize-pending
/.nvidia-nvenc-unpatched

# Root live config (seeded from the tracked template config/examples/config.yml)
/config.yml

# Test runtime artifacts (written inside the DinD copy; never committed)
# ─────────────────────────────────────────────────────────────
tests/.dind-state
tests/.image-override-applied
tests/.image-preflight-passed.tsv
tests/contracts/.spec-cache/
.tmp/

# Service runtime configs (generated by containers). Pre-seeded defaults live
# as tracked templates under config/examples/defaults/ and are copied into these
# gitignored live dirs on install, so the whole live dir is ignored.
config/jellyfin/
config/sonarr/
config/radarr/
config/seerr/
config/unpackerr/
config/homepage/
config/jackett/
config/qbittorrent/
config/fail2ban/
config/npm/
config/state/
config/wireguard/
config/ddns-updater/
config/bazarr/
config/uptime-kuma/
config/beszel/

# Backups
backups/

# Local plan files
docs/plans

# Python bytecode (wizard helpers regenerate this on import)
__pycache__/
*.pyc
