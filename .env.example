# =============================================================================
# MediaStack Configuration
# =============================================================================
# Copy to .env and edit: cp .env.example .env
# Most values are filled automatically by setup.sh
# =============================================================================

# --- Core ---

# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Etc/UTC

# User/Group ID (run 'id' in terminal to find yours - usually 1000)
PUID=1000
PGID=1000

# Where media and torrents are stored
DATA_DIR=/data

# Server address for dashboard links (auto-detected by setup.sh)
HOST_ADDRESS=localhost

# Container image update channel:
#   stable = MediaStack-tested digests from docs/image-digests.lock
#   latest = current upstream image tags from docker-compose.yml
IMAGE_CHANNEL=stable

# Docker bridge subnet chosen by setup.sh after LAN/VPN collision checks.
# Keep inside 172.16.0.0/12 unless you also update Docker-internal trust rules.
MEDIASTACK_NETWORK_PREFIX=172.28.0
MEDIASTACK_SUBNET=172.28.0.0/24
MEDIASTACK_GATEWAY=172.28.0.1
MEDIASTACK_NPM_IP=172.28.0.10

# --- Storage ---
# STORAGE_MODE controls mount protection:
#   local = local disk/no NAS watchdog
#   nas   = MediaStack mounts/checks NFS storage before data services start
STORAGE_MODE=local
# STORAGE_APP_WIRING controls app-level paths:
#   managed = MediaStack configures Jellyfin/Sonarr/Radarr/qBittorrent paths
#   manual  = install apps but skip app-level storage wiring
STORAGE_APP_WIRING=managed
STORAGE_PROTOCOL=
STORAGE_MOUNTPOINT=/data
STORAGE_NFS_HOST=
STORAGE_NFS_EXPORT=
STORAGE_NFS_OPTS=vers=4.2,proto=tcp,rw,hard,timeo=600,retrans=2,nosuid,nodev,noexec
STORAGE_SENTINEL=/data/.mediastack-storage-ready
STORAGE_EXPECTED_SOURCE=
STORAGE_EXPECTED_FSTYPE=

# --- Admin Credentials ---
# Single admin account used for all services:
#   Jellyfin, Sonarr, Radarr, Jackett, NPM, wg-easy, Seerr, Portainer, Beszel
JELLYFIN_ADMIN_USER=admin
JELLYFIN_ADMIN_PASSWORD=changeme

# Admin email (NPM and Beszel require email, not username)
NPM_ADMIN_EMAIL=admin@example.com

# --- qBittorrent ---
# Torrent peer port (forwarded on router for incoming connections)
TORRENT_PORT=6881
# Speed limits in MB/s (0 = unlimited). Overrides config.yml values.
QBT_DL_LIMIT=0
QBT_UL_LIMIT=0
# Public indexer preset is opt-in. Keep false unless you have confirmed the
# selected indexers are legal for your location and use case.
PUBLIC_INDEXERS_ENABLED=false
# Unpackerr watched torrent path. setup.sh clears this when
# STORAGE_APP_WIRING=manual so archive extraction stays user-configured.
UNPACKERR_TORRENT_PATHS=/data/torrents

# --- GPU (auto-detected by setup.sh) ---
# Options: nvidia, amd, intel, none
# setup.sh generates docker-compose.override.yml for GPU support
JELLYFIN_GPU=none
# NVIDIA driver-management mode, set by the Hardware Transcoding step:
#   standard = Debian-packaged nvidia-driver, official NVENC limits (default)
#   unlock   = patch-managed .run driver + nvidia-patch (advanced; removes limits)
#   existing = a pre-existing non-Debian driver MediaStack does not manage
# Primary source of truth; "patch enabled" is derived in code (true iff unlock).
NVIDIA_DRIVER_MODE=
STAGE_3_GPU_STATE=
STAGE_3_GPU_VENDOR=
STAGE_3_GPU_ENCODER=
STAGE_3_GPU_HW_DECODING_CODECS=
STAGE_3_GPU_DECODE_HEVC_10BIT=
STAGE_3_GPU_DECODE_VP9_10BIT=
STAGE_3_GPU_ALLOW_HEVC_ENCODING=
STAGE_3_GPU_ALLOW_AV1_ENCODING=
STAGE_3_GPU_RENDER_DEVICE=

# Jellyfin published URL for client apps (auto-set by configure.sh)
JELLYFIN_PUBLISHED_URL=http://localhost:8096

# --- Remote Access ---
# Proxy profile (NPM + fail2ban + DDNS): auto-enabled when DOMAIN is set
# VPN profile (WireGuard): docker compose --profile remote up -d

# Domain pointed at your home IP (for SSL certificates)
# NPM has built-in Let's Encrypt - no certbot needed.
# Just forward ports 80 + 443 on your router.
DOMAIN=example.com
# Remote HTTPS state:
#   unchecked = domain collected, remote setup not proven yet
#   ready     = HTTPS proxy hosts and certificates are live
#   skipped   = user kept LAN/VPN only for now
REMOTE_WEB_STATE=
# Optional ACME directory override for testing.
# Leave blank for trusted production certs. Example staging value:
# https://acme-staging-v02.api.letsencrypt.org/directory
NPM_LE_SERVER=

# DDNS provider credentials (Dynu). Collected by the Stage 2 wizard;
# ddns-updater itself reads from config/ddns-updater/config.json, not these
# vars. Persisted here so wizard re-runs pre-fill the Dynu prompts.
DDNS_USERNAME=
DDNS_PASSWORD=

# WireGuard VPN (wg-easy v15)
WG_HOST=example.com
# WireGuard listening port (forwarded on router for VPN connections)
WG_PORT=51820
# Plaintext admin password for wg-easy v15. INIT_PASSWORD is read at first
# boot only — once /etc/wireguard/wg-easy.db exists, changes here are inert
# (change the password inside the wg-easy UI instead). setup.sh defaults
# this to JELLYFIN_ADMIN_PASSWORD so a single credential works across
# services. Single-quoted: passwords may contain shell-special chars ($ " \ #).
WG_INIT_PASSWORD=''
WG_DEFAULT_DNS=1.1.1.1
# Access tier for the initial peer (set by setup.sh Stage-2 wizard):
#   full-lan   — initial peer reaches every device on your home LAN
#   server     — initial peer reaches this MediaStack box (all ports, incl. SSH)
#   containers — initial peer reaches MediaStack app ports only (no host services)
#   streaming  — README template for friends/kids (Jellyfin + Seerr + Homepage)
WG_ACCESS_TIER=full-lan
# Home LAN CIDR — used by the full-lan tier for both client routing and
# server-side firewallIps. Detected by the wizard; users confirm or override.
WG_LAN_CIDR=
# Server's LAN IP — mirrors HOST_ADDRESS. Used by server/containers/streaming
# tiers as the /32 routing target and the firewallIps prefix.
WG_SERVER_LAN_IP=
# Initial peer's allowedIps (what the peer's WireGuard config sends through
# the tunnel). Derived from WG_ACCESS_TIER. To enable full-tunnel routing,
# set this to '0.0.0.0/0, ::/0' AND set WG_PER_CLIENT_FIREWALL=false (both
# are required — server-side firewall would otherwise drop the routed traffic).
WG_INIT_ALLOWED_IPS='192.168.0.0/16'
# Server-side per-client firewall. true (default) = configure.sh enables
# wg-easy's per-client firewall globally and sets the initial peer's
# firewallIps per WG_ACCESS_TIER. Setting to false is the documented escape
# hatch for the advanced full-tunnel override.
WG_PER_CLIENT_FIREWALL=true

# --- Bazarr (subtitles profile) ---
BAZARR_ENABLED=false

# --- SMB file share (LAN only) ---
SMB_ENABLED=false
# data = share DATA_DIR as \\server\Media (recommended)
# system = share / as \\server\MediaStackSystem (advanced admin access)
SMB_SHARE_SCOPE=data

# --- host security ---
# UFW firewall (default-deny inbound, LAN/SSH/web allowed) and system
# hardening (unattended security upgrades + kernel sysctl). Both are chosen in
# the Stage 1 wizard and toggleable from the day-2 "Features & settings" menu.
# Absent => treated as true so existing installs stay hardened after upgrade.
UFW_ENABLED=true
HARDENING_ENABLED=true

# --- autoheal sidecar ---
# Restarts containers Docker has marked unhealthy (flaresolverr Chromium
# loops, NPM config drift, etc). Default true. Set to false to disable
# the sidecar entirely — useful for debugging unhealthy services.
AUTOHEAL_ENABLED=true

# --- Resource limits (power-user escape hatch) ---
# setup.sh auto-generates docker-compose.override.yml with mem_limit /
# memswap_limit / cpus on each service, scaled proportionally to host RAM
# (see scripts/setup/override.sh). Set to true to skip emitting those caps
# and let Docker manage memory itself. GPU passthrough and SMART caps are
# kept regardless. Only set this if you understand what you're trading off
# — without limits, the OOM killer picks the largest service when RAM
# runs out, which is usually NOT the actual offender.
MS_DISABLE_RESOURCE_LIMITS=false

# --- API Keys (auto-populated by configure.sh) ---
SONARR_API_KEY=
RADARR_API_KEY=
JELLYFIN_API_KEY=
BAZARR_API_KEY=
SEERR_API_KEY=
PORTAINER_API_KEY=
BESZEL_AGENT_KEY=

# --- Stage Markers ---
# Set to 1 by setup.sh after Stage 1 install completes successfully.
# Empty / unset = Stage 1 not yet completed.
STAGE_1_COMPLETE=
