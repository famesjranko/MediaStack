# MediaStack shellcheck configuration.
#
# Read automatically by shellcheck (and by tests/lint.sh), so the repo-specific
# flags live in one tracked place — nobody has to remember `-s bash -x`.

# Most shell files here are shebang-less sourced libraries and wizard stages
# (line 1 is a banner comment), so assume bash rather than erroring SC2148 on
# every one of them.
shell=bash

# Follow `# shellcheck source=...` directives so sourced helpers are analysed
# in the context of their caller (replaces the old `-x` flag).
external-sources=true

# Curated false-positive suppressions. Each is architectural noise, not a bug:
#   SC2329 — "function never invoked": sourced-library functions are called from
#            OTHER files shellcheck did not load. Inherent to the module layout.
#   SC2218 — "function only defined later": the mirror image of SC2329 — unit
#            harnesses deliberately call a product function before a later
#            `source`/mock (re)defines it (often to assert production source
#            order). Product code is SC2218-clean; only the intentional test
#            mock ordering trips it, so the shared suppression belongs here
#            instead of beside every fixture.
#   SC1091 — "not following": the runtime-generated ./.env and other sourced
#            files are absent at lint time. Expected.
#   SC1090 — "can't follow non-constant source": dynamic `source "$VAR"` paths.
#   SC2016 — "expressions don't expand in single quotes": intentional inside awk
#            and jq program strings (e.g. awk '{print $1}').
#   SC2015 — "A && B || C is not if-then-else": info-severity only, and the vast
#            majority of hits are log_ok/log_warn calls after a command whose
#            exit status the caller already handles — C never masks a failure
#            path there. Real if-then-else bugs are still worth reviewer eyes,
#            but a repo-wide gate on this pattern is noise, not a bug finder.
#   SC2032 — "function can't be invoked via sudo": fires on test-fixture command
#            stubs (docker, dpkg, chown, ...) that shadow a real binary the
#            product code never calls through sudo in the mocked path. The
#            stubs are deliberate; the warning does not apply to them.
#   SC2153 — "possible misspelling": near-miss heuristic that false-positives on
#            deliberately related but distinct names (e.g. a var and its
#            quoted-copy `_Q` sibling, or `TMP_DIR` vs a local `tmp_dir`) that
#            are common in this tree's fixture and quoting conventions.
disable=SC2329,SC2218,SC1091,SC1090,SC2016,SC2015,SC2032,SC2153
